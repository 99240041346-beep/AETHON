AETHON_ENV=development
AETHON_LOG_LEVEL=INFO
# PostgreSQL is the production target for durable memory.
AETHON_DATABASE_URL=postgresql://aethon:aethon@localhost:5432/aethon
AETHON_SQLITE_PATH=.aethon/aethon.db
# When set, protected API resources require Authorization: Bearer <token>.
AETHON_API_TOKEN=
AETHON_API_OWNER_ID=local-dev
AETHON_MODEL_PROVIDER=deterministic
AETHON_MODEL_BASE_URL=
AETHON_MODEL_NAME=
AETHON_MODEL_API_KEY=
# Semantic memory is opt-in. Production requires pgvector migration 003.
AETHON_EMBEDDING_PROVIDER=disabled
AETHON_EMBEDDING_BASE_URL=
AETHON_EMBEDDING_MODEL=text-embedding-3-small
AETHON_EMBEDDING_API_KEY=
AETHON_EMBEDDING_DIMENSION=1536
